<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="HeaderTopBar_Footer.Master.cs" Inherits="WAPP_EduNexus_App.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>EduNexus</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">

<link href="HeaderTopBar.css" rel="stylesheet">

<asp:ContentPlaceHolder ID="head" runat="server">
</asp:ContentPlaceHolder>
</head>

<body>
<form id="form1" runat="server">

    <%-- HEADER TOP BAR --%>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">EduNexus</a>
        <nav class="main-nav" aria-label="Primary">
            <a id="navHome"
               runat="server"
               href="~/CommonPage/Home.aspx"
               class="nav-link">
                Home
            </a>

            <a id="navBrowse"
               runat="server"
               href="~/LearningResourcePg/BrowseCourse.aspx"
               class="nav-link">
                Browse Courses
            </a>

            <a id="navLearning"
               runat="server"
               href="~/LearningResourcePg/MyLearningPage.aspx"
               class="nav-link">
                My Learning
            </a>
        </nav>
        <%-- GUEST --%>
        <asp:Panel ID="GuestBadge" runat="server" CssClass="header-auth">
            <a href="~/CommonPage/LoginPage.aspx" runat="server" class="header-login">Login</a>
            <a href="~/CommonPage/RegisterPage.aspx" runat="server" class="header-signup">Sign Up</a>
        </asp:Panel>

        <%-- LOGGED USERS --%>
        <asp:Panel ID="UserBadge" runat="server" CssClass="user-badge" Visible="False">
            <a href="~/CommonPage/EditProfile.aspx" runat="server" class="header-userlink">
               <asp:Image ID="imgUser" runat="server" CssClass="header-photo" />
                <asp:Label ID="lblHeaderName" runat="server" CssClass="username"></asp:Label>
            </a>
        </asp:Panel>
      </div>
    </header>


    <%-- PAGE CONTENT --%>
    <main class="page-content">

        <asp:ContentPlaceHolder
            ID="ContentPlaceHolder1"
            runat="server">

        </asp:ContentPlaceHolder>

    </main>


    <%-- FOOTER --%>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <p class="footer-logo">EduNexus</p>
          <p class="footer-desc">A platform for people who love <br /> learning — design, music, cooking, code,<br /> and more.</p>
        </div>
        <div class="footer-links">
          <div class="footer-col">
            <p class="footer-heading">Explore</p>
            <a href="/courses">All course</a>
            <a href="/music">Music</a>
            <a href="/cooking">Cooking</a>
            <a href="/design">Design</a>
          </div>
          <div class="footer-col">
            <p class="footer-heading">Account</p>

            <%-- GUEST --%>
            <a id="footerRegister" runat="server" href="~/CommonPage/RegisterPage.aspx">Create an account</a>
            <a id="footerLogin" runat="server" href="~/CommonPage/LoginPage.aspx">Login</a>

            <%-- LOGGED IN USER --%>
            <a id="footerUser" runat="server" href="~/CommonPage/EditProfile.aspx" visible="false"></a>

            <a href="/LearningResourcePg/MyLearningPage.aspx">My learning</a>
          </div>
        </div>
      </div>
    </footer>
</form>
</body>
</html>
